# JiaClaw 配置示例
# 复制此文件为 config/jiaclaw.toml 并根据需要调整

[agent]
# Agent 名称
name = "JiaClaw"

# Agent 描述
description = "Personal durable agent runtime"

# 系统指令
system_instructions = """
You are JiaClaw, a helpful personal assistant.
You can use tools, manage skills, and maintain conversation context.
Always be polite, concise, and accurate.
"""

# 最大对话轮次
max_turns = 10

# 工具调用超时（可选，环境变量 JIACLAW_TOOL_TIMEOUT_SECS 优先）
# 正整数：单次 tool 执行超过该秒数则把超时错误写入 tool result 并继续 loop
# 未设置或 0：不限制（默认，保持现状）
# tool_timeout_secs = 30

# 工具循环上限（可选，环境变量 JIACLAW_MAX_TOOL_ITERATIONS 优先）
# 正整数：整轮 tool loop 最大迭代次数。默认 5（与历史硬编码一致）
# 0 / 非法环境变量忽略；生效值钳制到 1–32，防止工具风暴
# max_tool_iterations = 5

[runtime]
# StateKnot 运行时配置（当 StateKnot 集成可用时）
# 
# # PostgreSQL 连接字符串
# database_url = "postgresql://user:password@localhost:5432/jiaclaw"
#
# # 租户 ID
# tenant_id = "default"
#
# # 工作目录
# work_dir = "/var/lib/jiaclaw"

[server]
# HTTP 服务器绑定地址
bind = "127.0.0.1:8080"

# 请求超时（秒）
timeout = 300

# 最大并发请求数
max_concurrent_requests = 100

[http]
# HTTP 服务绑定地址（优先级高于 [server] bind）
bind = "127.0.0.1:8080"

# Webhook 鉴权密钥（可选，环境变量 JIACLAW_WEBHOOK_SECRET 优先）
# 如果设置，/hooks/inbound 端点将验证 X-Webhook-Secret 请求头
# webhook_secret = "your-secret-here"

# Telegram Bot webhook secret token（可选，环境变量 JIACLAW_TELEGRAM_SECRET 优先）
# 如果设置，/hooks/telegram 校验头 X-Telegram-Bot-Api-Secret-Token（Telegram 官方 secret token）
# 未设置则与本地 webhook 一样开放（开发友好）
# telegram_secret = "your-telegram-secret-token"

# Telegram Bot API token（可选，环境变量 JIACLAW_TELEGRAM_BOT_TOKEN 优先）
# 如果设置，/hooks/telegram 在得到 assistant 回复后会 POST sendMessage 推回聊天（文本按 4096 截断）
# 出站失败仍返回 200 + 原 JSON reply，避免 Telegram webhook 重试。未设置则仅同步 JSON（与仅入站行为一致）
# telegram_bot_token = "123456:ABC-your-bot-token"

# Slack Events API signing secret（可选，环境变量 JIACLAW_SLACK_SIGNING_SECRET 优先）
# 如果设置，/hooks/slack 校验 X-Slack-Signature + X-Slack-Request-Timestamp（v0 HMAC-SHA256，±5 分钟）
# 未设置则开放（开发友好）。签名使用原始 body 字节。
# slack_signing_secret = "your-slack-signing-secret"

# Slack Bot token（可选，环境变量 JIACLAW_SLACK_BOT_TOKEN 优先）
# 如果设置，成功回复后会 POST chat.postMessage 推回 channel；未设置则仅同步 JSON
# slack_bot_token = "xoxb-your-bot-token"

# Discord Interactions 公钥（可选，环境变量 JIACLAW_DISCORD_PUBLIC_KEY 优先）
# 如果设置，/hooks/discord 校验 X-Signature-Ed25519 + X-Signature-Timestamp（Ed25519，timestamp + raw body）
# 未设置则开放（开发友好，doctor 警告）
# discord_public_key = "your-discord-hex-public-key"

# Discord Bot token（可选，环境变量 JIACLAW_DISCORD_BOT_TOKEN 优先）
# 如果设置，deferred ACK 后会 PATCH 编辑原始 Interaction；未设置则仅记 session
# discord_bot_token = "your-discord-bot-token"

# 将公网 HTTPS 端点登记为 Discord Interactions Endpoint URL：
# https://your-host.example/hooks/discord

# 将公网 HTTPS 端点登记为 Bot webhook（secret_token 对应上方 telegram_secret）：
# curl "https://api.telegram.org/bot<token>/setWebhook" \
#   -d "url=https://your-host.example/hooks/telegram" \
#   -d "secret_token=<telegram_secret>"

# CORS 允许的来源列表
# 空列表或 ["*"] 表示允许所有来源（默认）
# 设置特定来源以增强安全性（例如：["https://example.com", "https://app.example.com"]）
cors_allow_origins = ["*"]
# cors_allow_origins = ["https://example.com"]

# Session 持久化配置
# 是否将 session 持久化到磁盘（默认 false）
# 启用后，进程重启时可恢复多轮对话历史
persist = false

# Session 持久化文件路径（相对于 workspace_path）
# 默认: .jiaclaw/sessions.json
persist_path = ".jiaclaw/sessions.json"

# HTTP 限流（可选，环境变量 JIACLAW_RATE_LIMIT_PER_MINUTE 优先）
# 正整数：对 /api/* 与 /hooks/inbound、/hooks/telegram、/hooks/slack、/hooks/discord 做进程内全局限流（次/分钟）
# 未设置或 0：不限流。GET /health 始终不限流。
# 超限返回 429 并带 Retry-After。
# rate_limit_per_minute = 60

# Session 闲置 TTL（可选，环境变量 JIACLAW_SESSION_TTL_SECS 优先）
# 正整数：闲置超过该秒数后从内存 store 删除；落盘开启时同步 save
# 未设置或 0：不启用。create/chat/get/list 触达会刷新 last_accessed。
# session_ttl_secs = 3600

[session]
# 接近消息条数上限（50）时是否摘要压缩（默认 false，保持硬截断）
# 环境变量 JIACLAW_SESSION_SUMMARIZE_ON_OVERFLOW=1/true 可强制开启
# summarize_on_overflow = false
# 摘要后保留的最近消息条数（默认 10）
# keep_recent = 10

[logging]
# 日志级别: trace, debug, info, warn, error
level = "info"

# 日志格式: json, pretty, compact
format = "pretty"

# 日志输出: stdout, stderr, file
output = "stdout"

# 日志文件路径（当 output = "file" 时）
# file_path = "/var/log/jiaclaw/jiaclaw.log"

[tools]
# 启用的工具列表（示例，当前不驱动注册）
enabled = [
    # "search",
    # "calculator",
    # "file_operations",
]

# MCP 服务器配置（示例）
# [[tools.mcp_servers]]
# name = "example-server"
# url = "http://localhost:3000"
# auth_token = "your-token-here"

[tools.web_search]
# 可选联网检索（默认启用并注册）。无 Brave key 时调用返回友好错误，不访问网络。
# 环境变量 JIACLAW_BRAVE_API_KEY 优先于 brave_api_key；doctor / 日志不打印明文。
# 申请: https://brave.com/search/api/
enabled = true
# brave_api_key = "BSA..."

[tools.web_fetch]
# 可选网页抓取（默认启用并注册）。GET 页面，HTML 去标签为可读文本。
# 默认拒绝 localhost / 私网（127.0.0.0/8、::1、10/8、172.16/12、192.168/16、链路本地）。
# 内网调试可设 allow_private = true。HTTP 超时约 15s，并遵守 [agent] tool_timeout_secs。
enabled = true
# allow_private = false

[tools.memory_search]
# 可选工作区记忆检索（默认启用并注册）。按关键词/子串在 MEMORY / SOUL / USER 中找片段。
# 大小写不敏感；返回 {path, line, excerpt}。单文件超过 512KiB 截断并 warn。
# 可选参数 paths 指定工作区相对路径；禁止 .. / 绝对路径 / symlink 逃逸。不引入向量数据库。
enabled = true

[skills]
# 启用的技能列表（示例）
enabled = [
    # "file_management",
    # "web_search",
    # "code_assistant",
]

# 技能加载路径
# skill_paths = [
#     "./skills",
#     "~/.jiaclaw/skills",
# ]

[memory]
# 工作区长期记忆文件（相对于 workspace，默认 MEMORY.md）
# 每次对话开始时若文件存在且非空则注入系统提示；过大时截断到 32KiB。
# 可用工具 memory_append 追加或覆盖；变长后可用 memory_search 按关键词检索。缺省本段不影响现有配置。
path = "MEMORY.md"

[identity]
# 人格与用户画像（相对于 workspace；缺省本段即为 SOUL.md / USER.md）
# 每次对话开始时若文件存在且非空则分别注入独立区块；各文件独立 32KiB 截断。
# 可用工具 soul_write / user_write（默认覆盖整文件）。
soul_path = "SOUL.md"
user_path = "USER.md"

[heartbeat]
# 可选定时心跳（仅 jiaclaw serve 进程内；CLI chat 不跑）
# 默认关闭。启用后按 interval_secs 读取约定文件全文，作为 user 消息跑一轮 chat，
# 结果写入固定 session（默认 heartbeat），日志只打摘要。
# 文件缺失或为空：跳过本轮（debug），不退出。路径相对于 workspace，禁止穿越。
enabled = false
interval_secs = 3600
path = "HEARTBEAT.md"
session_id = "heartbeat"
# 环境变量 JIACLAW_HEARTBEAT_INTERVAL_SECS 可覆盖间隔（正整数）

[limits]
# 资源限制配置

# 最大消息长度（字符）
max_message_length = 10000

# 最大会话历史长度
max_history_length = 100

# 工具调用超时（秒）—— 实际生效字段为 [agent] tool_timeout_secs / JIACLAW_TOOL_TIMEOUT_SECS
# tool_timeout = 30

# 工具循环上限 —— 实际生效字段为 [agent] max_tool_iterations / JIACLAW_MAX_TOOL_ITERATIONS
# max_tool_iterations = 5

# 模型调用超时（秒）
model_timeout = 120

[provider]
# 模型提供商配置
#
# 推荐: Brokerrouter (生产路径)
type = "brokerrouter"
base_url = "https://api.brokerrouter.dev"
# API 密钥（建议使用环境变量 JIACLAW_API_KEY）
# api_key = "brk_live_..."
model = "claude-3-5-sonnet-20241022"
temperature = 0.7
max_tokens = 4096

# 备选: OpenAI-compatible (已废弃，仅作开发逃生舱)
# type = "openai_compatible"
# base_url = "https://api.openai.com/v1"
# api_key = "sk-..."
# model = "gpt-4o-mini"
# temperature = 0.7
# max_tokens = 4096
