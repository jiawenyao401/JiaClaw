{
  "agent": {
    "name": "JiaClaw",
    "description": "Personal durable agent runtime",
    "system_instructions": "You are JiaClaw, a helpful personal assistant.",
    "max_turns": 10,
    "provider": {
      "provider_type": "brokerrouter",
      "base_url": "https://api.brokerrouter.dev",
      "model": "claude-3-5-sonnet-20241022",
      "temperature": 0.7,
      "max_tokens": 4096
    },
    "tool_timeout_secs": null,
    "max_tool_iterations": 5
  },
  "server": {
    "bind": "127.0.0.1:8080",
    "timeout": 300
  },
  "logging": {
    "level": "info"
  },
    "http": {
      "bind": "127.0.0.1:8080",
      "cors_allow_origins": ["*"],
      "persist": false,
      "persist_path": ".jiaclaw/sessions.json",
      "rate_limit_per_minute": null,
      "session_ttl_secs": null,
      "metrics_public": true,
      "webhook_secret": null,
      "telegram_secret": null,
      "telegram_bot_token": null,
      "slack_signing_secret": null,
      "slack_bot_token": null,
      "discord_public_key": null,
      "discord_bot_token": null
    },
    "memory": {
      "path": "MEMORY.md"
    },
    "identity": {
      "soul_path": "SOUL.md",
      "user_path": "USER.md"
    },
    "heartbeat": {
      "enabled": false,
      "interval_secs": 3600,
      "path": "HEARTBEAT.md",
      "session_id": "heartbeat"
    },
    "session": {
      "summarize_on_overflow": false,
      "keep_recent": 10
    },
    "tools": {
      "web_search": {
        "enabled": true,
        "brave_api_key": null
      },
      "web_fetch": {
        "enabled": true,
        "allow_private": false
      },
      "memory_search": {
        "enabled": true
      }
    }
}
