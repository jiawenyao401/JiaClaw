{
  "openapi": "3.0.3",
  "info": {
    "title": "JiaClaw HTTP API",
    "version": "0.1.0",
    "description": "JiaClaw 个人持久化智能体运行时 HTTP 接口草图。\n\n鉴权：\n- Bearer：当配置了 `JIACLAW_API_TOKEN` 或 `[http].api_token` 时，`/api/*` 需要 `Authorization: Bearer <token>` 或 `X-Api-Token`。未配置时无需鉴权（本地开发友好）。\n- Webhook secret：当配置了 `JIACLAW_WEBHOOK_SECRET` 或 `[http].webhook_secret` 时，`POST /hooks/inbound` 需要 `X-Webhook-Secret`。\n- Telegram secret：当配置了 `JIACLAW_TELEGRAM_SECRET` 或 `[http].telegram_secret` 时，`POST /hooks/telegram` 需要 `X-Telegram-Bot-Api-Secret-Token`（Telegram 官方 secret token）。未配置则与本地 webhook 一样开放。\n\n限流：当配置了 `JIACLAW_RATE_LIMIT_PER_MINUTE` 或 `[http].rate_limit_per_minute`（正整数）时，`/api/*` 与 `/hooks/inbound`、`/hooks/telegram` 超限返回 429，并带 `Retry-After`。`GET /health` 不限流。\n\nSession TTL：当配置了 `JIACLAW_SESSION_TTL_SECS` 或 `[http].session_ttl_secs`（正整数）时，闲置超过该秒数的会话会从 store 删除。`GET /api/sessions` 只返回未过期项；对已过期 id 的 GET/DELETE 与不存在一致（GET 为 404）。create/chat/get/list 会刷新 last_accessed。\n\n请求追踪：所有响应回写 `X-Request-Id`。若请求未携带该头，服务端生成 UUID。"
  },
  "servers": [
    {
      "url": "/",
      "description": "当前 JiaClaw 进程"
    }
  ],
  "tags": [
    { "name": "health", "description": "健康检查" },
    { "name": "chat", "description": "聊天与会话" },
    { "name": "catalog", "description": "工具与技能目录" },
    { "name": "hooks", "description": "Webhook / Telegram 入站" },
    { "name": "discovery", "description": "API 发现" }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": ["health"],
        "summary": "健康检查",
        "operationId": "getHealth",
        "security": [],
        "responses": {
          "200": {
            "description": "服务可用",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthResponse" }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": ["chat"],
        "summary": "发送聊天消息",
        "operationId": "postChat",
        "security": [{ "bearerAuth": [] }, { "apiToken": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "聊天响应",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ChatResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/sessions": {
      "get": {
        "tags": ["chat"],
        "summary": "列出会话",
        "operationId": "listSessions",
        "description": "返回内存中当前未过期会话摘要（id 与 message_count）。启用 Session TTL 时会先清理过期项。落盘开启时也以内存 store 为准，与 chat/delete 一致。",
        "security": [{ "bearerAuth": [] }, { "apiToken": [] }],
        "responses": {
          "200": {
            "description": "会话列表",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ListSessionsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "post": {
        "tags": ["chat"],
        "summary": "创建会话",
        "operationId": "createSession",
        "security": [{ "bearerAuth": [] }, { "apiToken": [] }],
        "responses": {
          "200": {
            "description": "新会话 ID",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/CreateSessionResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/sessions/{id}": {
      "get": {
        "tags": ["chat"],
        "summary": "读取会话历史",
        "operationId": "getSession",
        "description": "返回内存中该会话的消息列表。不存在或已过期返回 404。落盘开启时也以内存 store 为准。",
        "security": [{ "bearerAuth": [] }, { "apiToken": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "会话消息",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/GetSessionResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      },
      "delete": {
        "tags": ["chat"],
        "summary": "删除会话",
        "operationId": "deleteSession",
        "security": [{ "bearerAuth": [] }, { "apiToken": [] }],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "删除结果（不存在时 success=false）",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/DeleteSessionResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/tools": {
      "get": {
        "tags": ["catalog"],
        "summary": "列出已注册工具",
        "operationId": "listTools",
        "security": [{ "bearerAuth": [] }, { "apiToken": [] }],
        "responses": {
          "200": {
            "description": "工具列表",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ToolsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/skills": {
      "get": {
        "tags": ["catalog"],
        "summary": "列出已发现技能",
        "operationId": "listSkills",
        "security": [{ "bearerAuth": [] }, { "apiToken": [] }],
        "responses": {
          "200": {
            "description": "技能列表",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/SkillsResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/api/openapi.json": {
      "get": {
        "tags": ["discovery"],
        "summary": "OpenAPI 3 文档草图",
        "operationId": "getOpenApi",
        "description": "鉴权与 GET /api/tools 一致：未配置 API token 时可匿名访问；已启用 token 时需 Bearer 或 X-Api-Token。",
        "security": [{ "bearerAuth": [] }, { "apiToken": [] }],
        "responses": {
          "200": {
            "description": "OpenAPI 3 JSON",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "type": "object" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/hooks/inbound": {
      "post": {
        "tags": ["hooks"],
        "summary": "Webhook 入站",
        "operationId": "inboundWebhook",
        "security": [{ "webhookSecret": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/InboundWebhookRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "入站处理结果",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/InboundWebhookResponse" }
              }
            }
          },
          "401": {
            "description": "Webhook secret 不匹配",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WebhookUnauthorized" }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    },
    "/hooks/telegram": {
      "post": {
        "tags": ["hooks"],
        "summary": "Telegram Bot 入站",
        "operationId": "inboundTelegram",
        "description": "接收 Telegram Bot API Update JSON，将 `message.text` / `edited_message.text` 映射到 session `telegram:{chat.id}` 并走现有 agent chat 路径。无文本的 update 返回 200 并带跳过说明。本切片同步回传 assistant 文本，不主动调用 sendMessage 出站。",
        "security": [{ "telegramSecret": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TelegramUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "入站处理结果（含跳过）",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/TelegramInboundResponse" }
              }
            }
          },
          "401": {
            "description": "Telegram secret token 不匹配",
            "headers": {
              "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/WebhookUnauthorized" }
              }
            }
          },
          "429": { "$ref": "#/components/responses/RateLimited" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "API token。未配置 token 时不需要。"
      },
      "apiToken": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Api-Token",
        "description": "Bearer 的替代头。未配置 token 时不需要。"
      },
      "webhookSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Webhook-Secret",
        "description": "Webhook 密钥。未配置 secret 时不需要。"
      },
      "telegramSecret": {
        "type": "apiKey",
        "in": "header",
        "name": "X-Telegram-Bot-Api-Secret-Token",
        "description": "Telegram Bot API secret token。未配置 `JIACLAW_TELEGRAM_SECRET` / `[http].telegram_secret` 时不需要。"
      }
    },
    "headers": {
      "XRequestId": {
        "description": "请求追踪 ID。请求未携带时由服务端生成 UUID。",
        "schema": { "type": "string" }
      },
      "RetryAfter": {
        "description": "限流后建议等待秒数",
        "schema": { "type": "integer", "minimum": 1 }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "API token 缺失或不匹配",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "NotFound": {
        "description": "会话不存在或已过期。JSON `error` 为 `session_not_found`。",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorBody" }
          }
        }
      },
      "RateLimited": {
        "description": "超过进程内全局限流（429）。JSON `error` 为 `rate_limit_exceeded`。",
        "headers": {
          "X-Request-Id": { "$ref": "#/components/headers/XRequestId" },
          "Retry-After": { "$ref": "#/components/headers/RetryAfter" }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/RateLimitError" }
          }
        }
      }
    },
    "schemas": {
      "HealthResponse": {
        "type": "object",
        "required": ["status", "agent_name", "version"],
        "properties": {
          "status": { "type": "string", "example": "ok" },
          "agent_name": { "type": "string" },
          "version": { "type": "string" }
        }
      },
      "ChatMessage": {
        "type": "object",
        "required": ["role", "content"],
        "properties": {
          "role": { "type": "string", "enum": ["user", "assistant", "system"] },
          "content": { "type": "string" }
        }
      },
      "ChatRequest": {
        "type": "object",
        "required": ["messages"],
        "properties": {
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatMessage" }
          },
          "enabled_tools": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "enabled_skills": {
            "type": "array",
            "items": { "type": "string" },
            "default": []
          },
          "auto_skills": { "type": "boolean", "default": true },
          "session_id": { "type": "string", "nullable": true }
        }
      },
      "ToolCall": {
        "type": "object",
        "properties": {
          "tool_name": { "type": "string" },
          "arguments": {},
          "result": {}
        }
      },
      "ChatResponse": {
        "type": "object",
        "properties": {
          "message": { "$ref": "#/components/schemas/ChatMessage" },
          "tool_calls": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ToolCall" }
          },
          "status": {
            "type": "string",
            "enum": ["running", "completed", "failed", "requires_human_input"]
          },
          "session_id": { "type": "string", "nullable": true }
        }
      },
      "CreateSessionResponse": {
        "type": "object",
        "properties": {
          "session_id": { "type": "string" }
        }
      },
      "SessionSummary": {
        "type": "object",
        "required": ["id", "message_count"],
        "properties": {
          "id": { "type": "string" },
          "message_count": { "type": "integer", "minimum": 0 }
        }
      },
      "ListSessionsResponse": {
        "type": "object",
        "required": ["sessions"],
        "properties": {
          "sessions": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SessionSummary" }
          }
        }
      },
      "GetSessionResponse": {
        "type": "object",
        "required": ["id", "messages"],
        "properties": {
          "id": { "type": "string" },
          "messages": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ChatMessage" }
          }
        }
      },
      "DeleteSessionResponse": {
        "type": "object",
        "properties": {
          "success": { "type": "boolean" },
          "message": { "type": "string" }
        }
      },
      "ToolInfo": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "ToolsResponse": {
        "type": "object",
        "properties": {
          "tools": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ToolInfo" }
          }
        }
      },
      "SkillInfo": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "description": { "type": "string" },
          "path": { "type": "string" }
        }
      },
      "SkillsResponse": {
        "type": "object",
        "properties": {
          "skills": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/SkillInfo" }
          }
        }
      },
      "InboundWebhookRequest": {
        "type": "object",
        "required": ["chat_id", "text"],
        "properties": {
          "channel": { "type": "string", "default": "webhook" },
          "chat_id": { "type": "string" },
          "text": { "type": "string" },
          "username": { "type": "string" }
        }
      },
      "InboundWebhookResponse": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean" },
          "session_id": { "type": "string" },
          "reply": { "type": "string" },
          "message": { "type": "string" },
          "error": { "type": "string" }
        }
      },
      "TelegramChat": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {
            "oneOf": [
              { "type": "integer", "format": "int64" },
              { "type": "string" }
            ],
            "description": "Telegram chat.id"
          }
        }
      },
      "TelegramMessage": {
        "type": "object",
        "required": ["chat"],
        "properties": {
          "chat": { "$ref": "#/components/schemas/TelegramChat" },
          "text": { "type": "string" }
        }
      },
      "TelegramUpdate": {
        "type": "object",
        "description": "Telegram Bot API Update 的最小子集；其余字段忽略。至少支持 message.text / edited_message.text。",
        "properties": {
          "update_id": { "type": "integer" },
          "message": { "$ref": "#/components/schemas/TelegramMessage" },
          "edited_message": { "$ref": "#/components/schemas/TelegramMessage" }
        }
      },
      "TelegramInboundResponse": {
        "type": "object",
        "required": ["ok"],
        "properties": {
          "ok": { "type": "boolean" },
          "reply": {
            "type": "string",
            "description": "同步回传的 assistant 文本（有文本的 update）"
          },
          "session_id": {
            "type": "string",
            "description": "telegram:{chat.id}"
          },
          "skipped": {
            "type": "boolean",
            "description": "无文本 update 时为 true"
          },
          "reason": {
            "type": "string",
            "example": "no text in update"
          }
        }
      },
      "WebhookUnauthorized": {
        "type": "object",
        "properties": {
          "ok": { "type": "boolean", "example": false },
          "error": { "type": "string", "example": "unauthorized" }
        }
      },
      "ErrorBody": {
        "type": "object",
        "properties": {
          "error": { "type": "string" }
        }
      },
      "RateLimitError": {
        "type": "object",
        "properties": {
          "error": { "type": "string", "example": "rate_limit_exceeded" }
        }
      }
    }
  }
}
